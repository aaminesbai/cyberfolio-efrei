{% extends '@frontend/base.html.twig' %}

{% block title %}Connexion Admin!{% endblock %}


{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-6 offset-md-3">
                <h1 class="text-center">Connexion</h1>
                <form class="form-signin" method="post">
                    

                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <label for="inputUsername" class="sr-only">Pseudo</label> <br>
                    <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" 
                    placeholder="Nom d'utilisateur" autocomplete="username" required autofocus>

                    <br>
                    <label for="inputPassword" class="sr-only">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" 
                        placeholder="Mot de passe" autocomplete="current-password" required>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    
                    <br>
                    <button class="btn btn-lg btn-primary btn-block" type="submit">
                        Se connecter
                    </button>
                </form>
                <br>
                {% if app.user %}
                    <div class="mb-3">
                        Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}